{
  "name": "school-cms",
  "version": "1.0.0",
  "description": "Complete Enterprise School Management System (School CMS) for Pakistani Schools",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "prisma:push": "npm --prefix backend run prisma:push"
  },
  "keywords": [
    "school-management-system",
    "school-cms",
    "pakistan-schools",
    "react",
    "express",
    "prisma",
    "mysql"
  ],
